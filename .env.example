# Build-time config consumed by react-native-config. Copy to `.env` (git-ignored).

# Non-secret account metadata as a JSON array. `id` is the broker's account
# number and joins with Keystore-provisioned creds at load time.
# Accounts with no provisioned cred are skipped until provisioning runs.
ACCOUNTS_JSON=[{"broker":"alpaca","id":"PA1","name":"Paper","is_paper":true}]

# Encrypted credentials blob (ciphertext — safe to embed as config). Produced by
# scripts/encrypt-credentials.mjs (its output prints this one-line value). Left
# unset → the app skips provisioning and treats accounts as already provisioned.
# CREDENTIALS_BLOB_JSON={"salt":"...","nonce":"...","ciphertext":"...","fingerprint":"..."}

# Backend base URL (fa-techan) consumed by react-native-config -> Config.API_BASE_URL (src/api.ts).
# Normal ops: the deployed dashboard. Local dev: your workstation LAN IP + :8000.
API_BASE_URL=https://fa-techan.lab

# MarketStore REST base URL consumed by react-native-config -> Config.MARKETSTORE_BASE_URL
# (src/marketstore.ts). Read-only market data (quotes + bars). Local dev: LAN IP + :5993.
MARKETSTORE_BASE_URL=https://marketstore.lab

# Optional auth header value sent verbatim as `Authorization` once MarketStore sits
# behind an authenticating reverse proxy. Unset -> no header (wide-open server).
# MARKETSTORE_AUTH_TOKEN=Bearer changeme
